<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_small"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="center">

    <!-- App Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💰 UANGKU"
        android:textColor="#CC00ADB5"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginBottom="6dp" />

    <!-- Label Saldo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Keluar Bulan Ini"
        android:textColor="#99FF5252"
        android:textSize="9sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Balance Amount -->
    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp –"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Last Updated -->
    <TextView
        android:id="@+id/widget_last_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="–"
        android:textColor="#55FFFFFF"
        android:textSize="9sp"
        android:gravity="center" />

</LinearLayout>
